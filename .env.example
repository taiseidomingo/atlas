# Copy to .env.local for local development; set the same names in Vercel for production.

# Required in production
SESSION_SECRET=           # long random string used to sign login cookies
ADMIN_PIN=                # admin password (admin login is disabled in production without it)
GEMINI_API_KEY=           # chatbot answers (without it the bot quotes the knowledge base directly)

# Optional
ADMIN_USERNAME=admin
CAMPUS_TIMEZONE=Asia/Manila
TEACHER_ACCOUNTS=         # extra read-only logins: "Name:password;Name2:password2"

# Vercel: added automatically when you connect Upstash Redis in the Storage tab.
# Leave empty locally to use the data/ folder instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
